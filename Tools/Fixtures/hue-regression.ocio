# Development-only differential configuration: video luminance and inverse HueFX periodic bounds.
ocio_profile_version: 2.5

environment:
  {}
search_path: ""
strictparsing: false
luma: [0.2126, 0.7152, 0.0722]

roles:
  default: raw
  scene_linear: Linear
  compositing_log: Log
  color_timing: Log
  aces_interchange: Linear

file_rules:
  - !<Rule> {name: Default, colorspace: default}

displays:
  sRGB:
    - !<View> {name: Raw, colorspace: raw}

active_displays: []
active_views: []

colorspaces:
  - !<ColorSpace>
    name: raw
    family: raw
    equalitygroup: ""
    bitdepth: 32f
    description: A raw color space. Conversions to and from this space are no-ops.
    isdata: true
    allocation: uniform

  - !<ColorSpace>
    name: Linear
    family: ""
    equalitygroup: ""
    bitdepth: unknown
    isdata: false
    allocation: uniform

  - !<ColorSpace>
    name: Video
    family: ""
    equalitygroup: ""
    bitdepth: unknown
    isdata: false
    allocation: uniform
    to_scene_reference: !<GradingHueCurveTransform>
      style: video
      hue_hue: {control_points: [0.03, 0.01470819, 0.27, 0.3064156, 0.53, 0.5179977, 0.79, 0.7825491]}
      hue_sat: {control_points: [0.03, 1.17848, 0.27, 1.082514, 0.53, 0.9513495, 0.79, 1.020187]}
      hue_lum: {control_points: [0.03, 0.8346943, 0.27, 0.9976508, 0.53, 0.9681807, 0.79, 1.1933]}
